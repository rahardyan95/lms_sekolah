APP_NAME="SIAKAD LMS Sekolah"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Error tracking Sentry (kosong = nonaktif). Isi di staging/prod.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_ENVIRONMENT="${APP_ENV}"

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=lms_sekolah
DB_USERNAME=lms
DB_PASSWORD=secret

SESSION_DRIVER=redis
SESSION_LIFETIME=30
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
# Isi untuk mengaktifkan requirepass Redis (WAJIB diisi di production).
# Kosongkan (= tanpa nilai) bila tanpa password — JANGAN tulis "null"
# (Laravel membaca string "null" sebagai kosong, tapi redis-server memakainya
# sebagai password sehingga worker gagal NOAUTH).
REDIS_PASSWORD=
REDIS_PORT=6379

MEILISEARCH_HOST=http://meilisearch:7700
# Ganti dengan kunci kuat di production (jangan pakai default).
MEILI_MASTER_KEY=meiliMasterKey123

# Gateway WhatsApp (provider: log | fonnte | wablas | custom)
# DEC-001 go-live (locked 11 Sep 2026): primary Fonnte, fallback Wablas.
WA_PROVIDER=log
WA_ENDPOINT=
WA_API_KEY=
WA_SENDER=
# Penyedia cadangan + kredensialnya. Kosong = tanpa fallback; endpoint/key
# kosong akan memakai kredensial utama.
WA_FALLBACK_PROVIDER=
WA_FALLBACK_ENDPOINT=
WA_FALLBACK_API_KEY=

# Password akun demo dari RolePermissionSeeder — hanya dipakai di luar production.
SEED_DEMO_PASSWORD=password123

# Masa berlaku token Sanctum dalam menit (kosongkan = non-expiring, hanya untuk dev).
SANCTUM_TOKEN_EXPIRATION=

SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:8080,localhost:3000

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080,http://localhost:3000

SCHOOL_NAME="SMK Negeri 1 Jakarta"
SCHOOL_TIMEZONE=Asia/Jakarta
SCHOOL_LATE_AFTER=07:00

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
VITE_API_URL=http://localhost:8000/api/v1
