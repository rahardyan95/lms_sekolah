# Template production VPS — salin menjadi .env di server, JANGAN commit.
# cp .env.prod.example .env  (di server)
APP_NAME="SIAKAD LMS Sekolah"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.sekolah.sch.id
FRONTEND_URL=https://sekolah.sch.id

# Reverse proxy Caddy (TLS otomatis ACME):
# - CADDYFILE=Caddyfile.prod wajib di production (dev default: Caddyfile :80).
# - API_HOST/FRONTEND_HOST = hostname DNS saja (tanpa https://), harus A-record ke VPS.
# - ACME_EMAIL = email untuk notifikasi sertifikat Let's Encrypt.
CADDYFILE=Caddyfile.prod
API_HOST=api.sekolah.sch.id
FRONTEND_HOST=sekolah.sch.id
ACME_EMAIL=admin@sekolah.sch.id

# Log JSON ke stderr container (docker logs) — bukan file di dalam container.
LOG_CHANNEL=stderr
LOG_STDERR_FORMATTER=Monolog\Formatter\JsonFormatter::class
LOG_LEVEL=warning

# Sentry Cloud: isi DSN agar error + monitor terkirim (alerting di dashboard Sentry).
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_ENVIRONMENT=production

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=lms_sekolah
DB_USERNAME=lms
DB_PASSWORD=GANTI_PASSWORD_KUAT

SESSION_DRIVER=redis
SESSION_LIFETIME=30
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=.sekolah.sch.id
SESSION_SAME_SITE=lax

QUEUE_CONNECTION=redis
CACHE_STORE=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
# WAJIB diisi — mengaktifkan requirepass Redis di container redis.
REDIS_PASSWORD=GANTI_REDIS_PASSWORD_KUAT

MEILISEARCH_HOST=http://meilisearch:7700
MEILI_MASTER_KEY=GANTI_MEILI_KEY

# Gateway WhatsApp — WAJIB provider nyata di production: OTP login orang tua & notifikasi
# presensi dikirim via sini. Provider 'log' TIDAK mengirim apa-apa dan akan menggagalkan
# app:readiness (container menolak boot). Endpoint default mengikuti provider:
#   fonnte  -> https://api.fonnte.com/send   (Authorization: <token>, body {to, message})
#   wablas  -> https://<domain-anda>.wablas.com/api/send-message
#   custom  -> URL milik sendiri (format body {to, message} + header Authorization)
WA_PROVIDER=fonnte
WA_ENDPOINT=https://api.fonnte.com/send
WA_API_KEY=GANTI_WA_API_KEY
WA_SENDER=
# Fallback DEC-001: Fonnte gagal → Wablas. Kosong = tanpa fallback.
WA_FALLBACK_PROVIDER=wablas
WA_FALLBACK_ENDPOINT=
WA_FALLBACK_API_KEY=

# Akun demo otomatis TIDAK dibuat saat APP_ENV=production (lihat RolePermissionSeeder).
SEED_DEMO_PASSWORD=

# Backup offsite (RPO ≤1 jam). Backup lokal berjalan TIAP JAM via scheduler
# (retensi 48 file ≈ 2 hari); isi bucket agar salinan keluar dari VPS.
# Isi juga kredensial AWS_* di bawah bila memakai S3-compatible non-AWS.
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=

# Trusted proxy (IP reverse proxy/TLS terminator) — wajib agar rate-limit & audit log
# memakai IP asli klien. '*' aman bila container hanya reachable via proxy.
TRUSTED_PROXIES=*

# Runtime HTTP produksi: Laravel Octane + FrankenPHP (worker mode).
# Worker diatur Octane (default auto = jumlah CPU); max-requests 500 di CMD Dockerfile.
# OPSIONAL — sesuaikan bila VPS punya RAM terbatas:
# OCTANE_WORKERS=4

# Masa berlaku token Sanctum (menit) — wajib diisi di production.
SANCTUM_TOKEN_EXPIRATION=120

SANCTUM_STATEFUL_DOMAINS=sekolah.sch.id
CORS_ALLOWED_ORIGINS=https://sekolah.sch.id

MAIL_MAILER=smtp
MAIL_HOST=GANTI_SMTP_HOST
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@sekolah.sch.id"

SCHOOL_NAME="SMK Negeri 1 Jakarta"
SCHOOL_TIMEZONE=Asia/Jakarta
SCHOOL_LATE_AFTER=07:00

VITE_API_URL=https://api.sekolah.sch.id/api/v1
